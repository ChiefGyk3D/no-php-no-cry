{
  "version": 1,
  "note": "Canonical design tokens. The blog's values win (docs/redesign-brief.md section 6). scripts/gen-tokens.py generates assets/css/tokens.css from this file; scripts/check-contrast.py checks the result. Colors are 6-digit hex so the checker can read them.",
  "fontFace": {
    "family": "Jost",
    "weight": "100 900",
    "src": "../fonts/jost-latin-wght-normal.woff2"
  },
  "dark": [
    {
      "comment": "Color: dark palette (default).",
      "themed": true,
      "tokens": {
        "accent": "#FBB03B",
        "on-accent": "#1A1A1A",
        "bg": "#0E0E0E",
        "surface": "#181716",
        "text": "#F0F0F0",
        "muted": "#B5ADA2",
        "link": "#FBB03B",
        "focus": "#FBB03B",
        "rule": "#3A3530",
        "border": "#3A3530"
      }
    },
    {
      "comment": "Redesign surfaces. Carbon, plate, ghost: dark mode only. Cream plate: both modes, focus and links use --focus-on-plate. --accent-deep: decoration, never text.",
      "themed": true,
      "tokens": {
        "carbon-base": "#181818",
        "carbon-line": "#282828",
        "plate": "#281808",
        "ghost": "#383838",
        "accent-deep": "#AF6A0E",
        "plate-light": "#FFEFD9",
        "focus-on-plate": "#8A5A00"
      }
    },
    {
