        "code-keyword": "#FBB03B",
        "code-string": "#9ED28A",
        "code-number": "#7FC8E8",
        "code-function": "#C9A8F0",
        "code-comment": "#A8A093",
        "code-deleted": "#F4968D",
        "code-inserted": "#9ED28A"
      }
    },
    {
      "comment": "Effects: amber glow. Alpha values, so they are not contrast-checked.",
      "themed": true,
      "tokens": {
        "glow": "rgb(251 176 59 / 0.16)",
        "glow-strong": "rgb(251 176 59 / 0.35)",
        "shadow": "rgb(0 0 0 / 0.5)"
      }
    },
    {
      "comment": "Type.",
      "tokens": {
        "font-body": "Jost, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
        "font-mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
        "text-sm": "0.875rem",
        "text-base": "1.125rem",
        "text-lg": "1.375rem",
        "text-xl": "1.75rem",
        "text-2xl": "2.25rem",
        "line-height": "1.6"
      }
    },
    {
      "comment": "Space (4-point rhythm) and layout.",
      "tokens": {
        "space-1": "0.25rem",
        "space-2": "0.5rem",
        "space-3": "0.75rem",
        "space-4": "1rem",
        "space": "var(--space-4)",
        "space-5": "1.5rem",
        "space-6": "2.5rem",
        "measure": "42rem",
        "radius": "0.5rem",
        "tap": "2.75rem"
      }
