{{- /*
  Cloudflare Pages _redirects: a 301 for every front-matter alias, for every
  page. Hugo hands aliases back without a trailing slash, so each alias gets
  two lines, with and without the slash (an old WordPress permalink ends in a
  slash, and a mistyped one may not). An alias ending in .html is a file, so it
  gets exactly one line. With no aliases the file holds only the
  comment line. Sorted and de-duplicated so the file is stable between builds.
  Cloudflare allows 2000 static rules.
*/ -}}
{{- $lines := slice -}}
{{- range site.Pages -}}
  {{- $target := .RelPermalink -}}
  {{- range .Aliases -}}
    {{- $from := strings.TrimSuffix "/" . -}}
    {{- if not (hasPrefix $from "/") }}{{ $from = printf "/%s" $from }}{{ end -}}
    {{- if and (ne $from "") (ne $from "/") -}}
      {{- if strings.HasSuffix $from ".html" -}}
        {{- $lines = $lines | append (printf "%s %s 301" $from $target) -}}
      {{- else -}}
        {{- $lines = $lines | append (printf "%s/ %s 301" $from $target) (printf "%s %s 301" $from $target) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $lines = sort (uniq $lines) -}}
# Generated by Hugo from page aliases. Do not edit. Rules: {{ len $lines }}
{{ range $lines }}{{ . }}
{{ end -}}
