{{- /*
  Cloudflare Pages _redirects. Limits (Cloudflare Pages docs, "Redirects",
  fetched 2026-11-06, verified): 2000 static and 100 dynamic rules per file, a
  1000-character line, the top-most matching rule wins, static rules go before
  dynamic ones, only 301/302/303/307/308 redirects plus a 200 proxy to a local
  path, one splat per rule, and redirects run before headers.

  Static rules, in this order of sources:
  1. A 301 for every front-matter alias, for every page. Hugo hands aliases
     back without a trailing slash, so each alias gets two lines, with and
     without the slash (an old WordPress permalink ends in a slash, and a
     mistyped one may not). An alias ending in .html is a file, so it gets
     exactly one line. An alias_fragment must match the fragment grammar
     (letters, digits, '.', '_', '~', '-') or the build fails.
  2. The WordPress feed addresses all go to the real file /feed/index.xml (301,
     one hop): /feed/, /feed, /feed/atom/ and /comments/feed/, with and without
     the trailing slash. A reader that asked for Atom gets RSS, which readers
     accept. The comments feed is gone with the comments. (A 200 rewrite of
     /feed/ and a Content-Type rule would need a second _headers block and a
     200 line, which scripts/check-site-artifact.sh forbids on purpose.)
  3. /category/<slug>/ goes to the matching category page when one exists, and
     /category/uncategorized/ to /posts/ otherwise.
  4. /YYYY/ and /YYYY/MM/ date archives, only for the years and months that
     hold a published post, go to /posts/. Placeholders (/:year/:month/) are not
     used: they match any one-segment path and would capture /posts/<slug>/.
  5. data/legacy_uploads.json: old /wp-content/uploads/ image addresses used by
     the migrated posts, generated by the converter (tools/wxr2hugo). A bad
     entry fails the build.
  Dynamic rules, last: /category/* and /page/* go to /posts/ (any other
  category, and WordPress paging, have no counterpart).
  Every line is sorted and de-duplicated so the file is stable between builds.
*/ -}}
{{- $static := slice -}}
{{- /* 1. aliases */ -}}
{{- range site.Pages -}}
  {{- $target := .RelPermalink -}}
  {{- with .Params.alias_fragment -}}
    {{- $frag := printf "%v" . -}}
    {{- if not (findRE `^[A-Za-z0-9._~-]+$` $frag 1) -}}
      {{- errorf "alias_fragment %q on %s must use only letters, digits, '.', '_', '~' and '-'" $frag $.File.Path -}}
    {{- end -}}
    {{- $target = printf "%s#%s" $target $frag -}}
  {{- end -}}
  {{- range .Aliases -}}
    {{- $from := strings.TrimSuffix "/" . -}}
    {{- if not (hasPrefix $from "/") }}{{ $from = printf "/%s" $from }}{{ end -}}
    {{- if and (ne $from "") (ne $from "/") -}}
      {{- if strings.HasSuffix $from ".html" -}}
        {{- $static = $static | append (printf "%s %s 301" $from $target) -}}
      {{- else -}}
        {{- $static = $static | append (printf "%s/ %s 301" $from $target) (printf "%s %s 301" $from $target) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- /* 2. feeds */ -}}
{{- $static = $static | append "/feed /feed/index.xml 301" "/feed/ /feed/index.xml 301" "/feed/atom /feed/index.xml 301" "/feed/atom/ /feed/index.xml 301" "/comments/feed /feed/index.xml 301" "/comments/feed/ /feed/index.xml 301" -}}
{{- /* 3. categories */ -}}
{{- $seen := dict -}}
{{- range site.Taxonomies.categories -}}
  {{- $slug := path.Base (strings.TrimSuffix "/" .Page.RelPermalink) -}}
  {{- $seen = merge $seen (dict $slug true) -}}
  {{- $static = $static | append (printf "/category/%s %s 301" $slug .Page.RelPermalink) (printf "/category/%s/ %s 301" $slug .Page.RelPermalink) -}}
{{- end -}}
{{- if not (index $seen "uncategorized") -}}
  {{- $static = $static | append "/category/uncategorized /posts/ 301" "/category/uncategorized/ /posts/ 301" -}}
{{- end -}}
{{- /* 4. date archives */ -}}
{{- range where site.RegularPages "Section" "posts" -}}
  {{- $y := .Date.Format "2006" -}}
  {{- $ym := .Date.Format "2006/01" -}}
  {{- $static = $static | append (printf "/%s /posts/ 301" $y) (printf "/%s/ /posts/ 301" $y) (printf "/%s /posts/ 301" $ym) (printf "/%s/ /posts/ 301" $ym) -}}
{{- end -}}
{{- /* 5. old upload addresses */ -}}
{{- range site.Data.legacy_uploads -}}
  {{- $from := printf "%v" .from -}}
  {{- $to := printf "%v" .to -}}
  {{- if not (and (findRE `^/wp-content/uploads/[A-Za-z0-9._~/%-]+$` $from 1) (findRE `^/[A-Za-z0-9._~/%-]+$` $to 1)) -}}
    {{- errorf "data/legacy_uploads.json entry %q -> %q: the source must be /wp-content/uploads/... and the target a local path, both using only letters, digits, '.', '_', '~', '/', '%%' and '-'" $from $to -}}
  {{- end -}}
  {{- $static = $static | append (printf "%s %s 301" $from $to) -}}
{{- end -}}
{{- $static = sort (uniq $static) -}}
{{- $dynamic := slice "/category/* /posts/ 301" "/page/* /posts/ 301" -}}
{{- if gt (len $static) 2000 -}}
  {{- errorf "_redirects has %d static rules; Cloudflare Pages allows 2000" (len $static) -}}
{{- end -}}
# Generated by Hugo from page aliases and the legacy WordPress addresses. Do not edit. Rules: {{ add (len $static) (len $dynamic) }}
{{ range $static }}{{ . }}
{{ end }}{{ range $dynamic }}{{ . }}
{{ end -}}
