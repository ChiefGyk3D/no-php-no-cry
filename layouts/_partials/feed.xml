{{- /* RSS 2.0 feed body, shared by layouts/rss.xml (/index.xml, /posts/index.xml, /journal/index.xml) and layouts/home.feed.xml (the site feed, /feed/index.xml). Takes a dict: "page" and "format" (the output format whose address is the atom self link). Entries marked syndicate: false stay in the feed: the flag is for the later syndication step, not for the feed. Each item carries the full rendered body (an RSS reader shows the post, not a teaser). */ -}}
{{- $p := .page -}}
{{- $pages := $p.Pages -}}
{{- if $p.IsHome }}{{ $pages = where site.RegularPages "Section" "in" (slice "posts" "journal") }}{{ end -}}
{{- /* A draft (built only on the staging host, with --buildDrafts) never reaches a feed: the feed is what a reader or a syndication step reads. */ -}}
{{- $pages = where $pages "Draft" false -}}
{{- $limit := 20 -}}
{{- /* The declaration goes through safeHTML: the template is escaped as HTML, which turns a literal <?xml into &lt;?xml and makes the feed invalid XML. */ -}}
{{ `<?xml version="1.0" encoding="utf-8"?>` | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if $p.IsHome }}{{ site.Title }}{{ else }}{{ $p.Title }} | {{ site.Title }}{{ end }}</title>
    <link>{{ $p.Permalink }}</link>
    <description>{{ $p.Description | default site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{- with $p.OutputFormats.Get .format }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType.Type | safeHTML }}
    {{- end }}
    {{- with index ($pages.ByDate.Reverse) 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- range first $limit $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <description>{{ .Content | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
